# PayPerCall configuration. Copy to .env (local) or set in the Vercel project settings.
# Never commit real values. Only VITE_ variables are exposed to the browser.

# Deployed PayPerCall contract on Arc mainnet (chain 5042). Leave empty until the contract is deployed:
# the API and the UI both fail closed while this is empty or invalid. Public value.
VITE_PAY_PER_CALL_ADDRESS=

# Durable store for request records (required in production; Upstash Redis REST).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local development and tests only. Never allowed on Vercel.
# PPC_ALLOW_MEMORY_STORE=1

# Optional: https RPC override. Defaults to the Arc mainnet endpoint from docs.arc.io.
# ARC_MAINNET_RPC_URL=

# Optional: key of the contract's operator, used to settle requests after a report is ready.
# Server only. Without it requests stop at REPORT_READY and nothing is settled or released.
# PPC_OPERATOR_PRIVATE_KEY=

# Secret (16+ chars) for /api/v1/cron/process. Vercel Cron sends it as `Authorization: Bearer <secret>`.
# Without it the endpoint is hidden and scheduled processing does not run.
# CRON_SECRET=

# Optional: local API port used by `bun run dev:api` (Vite proxies /api to it).
# PPC_API_PORT=3001
